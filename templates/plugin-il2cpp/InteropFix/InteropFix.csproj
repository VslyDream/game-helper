<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Пересохранение interop-сборок BepInEx через Mono.Cecil (когда и как запускать: ../README.md, раздел InteropFix).
    Нужен NuGet (Mono.Cecil): один раз онлайн или локальный источник пакетов.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- запускается и на более новом установленном рантайме -->
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
